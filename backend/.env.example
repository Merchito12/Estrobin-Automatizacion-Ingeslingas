# Copia este archivo como .env (no se versiona) o define las variables en Render.

# Orígenes permitidos por CORS, separados por coma. Valores exactos, sin "/" final y sin "*".
# Producción: el origen de GitHub Pages (solo dominio, sin la ruta del repositorio).
ALLOWED_ORIGINS=https://tu-usuario.github.io,http://localhost:5500,http://127.0.0.1:5500

# Minutos que se conserva un archivo generado si nadie lo descarga.
JOB_TTL_MINUTES=30

# Tamaño máximo de carga en MB.
MAX_UPLOAD_MB=25

# Carpeta temporal de trabajo (opcional). Por defecto: <tmp>/ingeslingas-excel-portal
# WORK_DIR=/tmp/ingeslingas-excel-portal

LOG_LEVEL=INFO

# Documentación interactiva (/docs). Mantener desactivada en producción.
# ENABLE_DOCS=true
